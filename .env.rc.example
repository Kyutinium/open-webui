# Secrets — copy this file to .env and fill in real values
# cp .env.rc.example .env

WEBUI_SECRET_KEY=CHANGE_ME
DATABASE_PASSWORD=CHANGE_ME

# SSO department validation
SSO_API_URL=http://
SSO_API_KEY=CHANGE_ME
SSG_DEPT_CODES=["aaaaa", "xxx"]

# Department index (storage only, never an access gate).
# Ordered candidate list where one SSG code == one department; a user's stored
# d_index is the 1-based position of the first code they belong to, 0 if none.
# Reordering renumbers already-stored indexes.
SSG_D_INDEX_CODES=["ddddd", "eeeee"]
# Re-resolve the index on every login instead of resolving it once
# (costs one SSO request per candidate code per login).
SSG_D_INDEX_REFRESH_ON_LOGIN=false
